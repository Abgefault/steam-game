; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Green Empire: Industrial Cannabis Tycoon"
config/description="First-person business simulation and factory automation tycoon. Inherit a bankrupt licensed cannabis company in the fictional city of Verdantia and win the city supply contract in 180 days."
config/version="1.0.0"
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/low_processor_mode=false
boot_splash/bg_color=Color(0.0509804, 0.0745098, 0.0588235, 1)
config/icon="res://assets/icon.svg"

[audio]

buses/default_bus_layout="res://assets/audio/bus_layout.tres"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
DataRegistry="*res://scripts/core/data_registry.gd"
SettingsService="*res://scripts/core/settings_service.gd"
Game="*res://scripts/core/game_state.gd"
SimClock="*res://scripts/core/sim_clock.gd"
SaveService="*res://scripts/core/save_service.gd"
AudioService="*res://scripts/core/audio_service.gd"
SceneRouter="*res://scripts/core/scene_router.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="disabled"

